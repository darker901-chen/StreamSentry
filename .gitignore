# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md

# Project governance and workflow files (this project)
!CLAUDE.md
!SPEC.md
!ARCHITECTURE.md
!SETUP.md
!TESTING.md
!CHANGELOG.md
!/.claude
!/scripts
!/reports
!/tests

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber
